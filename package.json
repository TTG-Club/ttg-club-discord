{
  "name": "ttg-club-discord",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "packageManager": "pnpm@10.31.0",
  "description": "TTG Club Discord Bot",
  "license": "MIT",
  "keywords": [],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "pnpm run build && dotenvx run -- node dist/index.js",
    "build": "pnpm run clean && tsc --project tsconfig.json",
    "clean": "rimraf dist",
    "type-check": "tsc --noEmit --project tsconfig.json",
    "lint:check": "eslint . --cache --cache-strategy content",
    "lint:write": "eslint . --cache --cache-strategy content --fix",
    "lint:workflow": "eslint . --cache --cache-strategy content --quiet"
  },
  "dependencies": {
    "@discordjs/rest": "^2.6.0",
    "@truto/turndown-plugin-gfm": "^1.0.2",
    "axios": "^1.13.6",
    "chalk": "^5.6.2",
    "colord": "^2.9.3",
    "dice-roller-parser": "^0.1.8",
    "discord.js": "^14.25.1",
    "express": "^5.2.1",
    "jsdom": "^28.1.0",
    "lodash-es": "^4.17.23",
    "pagination.djs": "^4.0.18",
    "sanitize-html": "^2.17.1",
    "turndown": "^7.2.2"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^1.54.1",
    "@svifty7/eslint-config": "^0.2.1",
    "@types/express": "^5.0.6",
    "@types/jsdom": "^28.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "~25.3.5",
    "@types/sanitize-html": "^2.16.1",
    "@types/turndown": "^5.0.6",
    "eslint": "^10.0.3",
    "eslint-plugin-format": "^2.0.1",
    "lint-staged": "^16.3.2",
    "rimraf": "^6.1.3",
    "simple-git-hooks": "^2.13.1",
    "typescript": "^5.9.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "volta": {
    "node": "24.14.0",
    "pnpm": "10.31.0"
  }
}
